NODE_ENV=development
MQTT_URL=mqtt://localhost:1883
MQTT_QOS=1
MQTT_CLIENT_ID_PREFIX=greeting
# Sesión persistente del suscriptor: el broker encola mensajes mientras está
# apagado. Debe ser true/false (no "1"/"yes") y exige QoS 1 o 2.
MQTT_PERSISTENT_SESSION=true
# clientId fijo del suscriptor cuando la sesión es persistente. Por defecto:
# ${MQTT_CLIENT_ID_PREFIX}-subscriber (por ejemplo, greeting-subscriber).
MQTT_SUBSCRIBER_CLIENT_ID=greeting-subscriber
# Opcional. Si se define, se usa MQTT 5 con sessionExpiryInterval (segundos).
# Si no se define, se usa MQTT 3.1.1 y el broker decide cuánto conserva la sesión.
# MQTT_SESSION_EXPIRY_SECONDS=604800
ASYNCAPI_PATH=asyncapi.yaml
PUBLISHER_NAME=Belisarius-Cawl
