{
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start:pub": "tsx --env-file=.env src/publisher.ts",
    "start:sub": "tsx --env-file=.env src/subscriber.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run --dir test/unit",
    "test:e2e": "vitest run --dir test/e2e",
    "docs:validate": "pnpm dlx @asyncapi/cli validate asyncapi.yaml",
    "docs:build": "pnpm dlx @asyncapi/cli generate fromTemplate asyncapi.yaml @asyncapi/html-template@3 -o docs --force-write",
    "docs:studio": "pnpm dlx @asyncapi/cli start studio asyncapi.yaml"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "asyncapi": "^2.6.1",
    "install": "^0.13.0",
    "mqtt": "^5.16.1",
    "studio": "^0.13.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
